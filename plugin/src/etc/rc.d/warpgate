#!/bin/sh

# PROVIDE: warpgate
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# warpgate_enable (bool):   YES to run warpgate (set by the OPNsense template in /etc/rc.conf.d/warpgate)
# warpgate_config (path):   config file, generated by the plugin template
# warpgate_data (path):     the service's own data (default database, recordings)
# warpgate_user (str):      run as this user (rc.subr starts daemon(8) as it)
# warpgate_debug (str):     -d or -dd for debug/trace logging
# warpgate_run_flags (str): flags for `warpgate run` (--enable-admin-token)
# warpgate_env_file (path): sourced by rc.subr: WARPGATE_ADMIN_TOKEN, in a root-only file
#
# start = prepare (directories, self-signed certificate, trust store export), `warpgate check`,
# database bootstrap (idempotent: creates the admin user only in an empty database), then daemon(8).

# rc.subr idioms: variables are read by rc.subr, local is supported by FreeBSD sh
# shellcheck disable=SC1091,SC2034,SC2223,SC3043
. /etc/rc.subr

name=warpgate
rcvar=warpgate_enable
load_rc_config $name

: ${warpgate_enable:=NO}
: ${warpgate_config:=/usr/local/etc/warpgate/warpgate.yaml}
: ${warpgate_data:=/var/db/warpgate}
: ${warpgate_user:=warpgate}
: ${warpgate_debug:=}
: ${warpgate_run_flags:=}

scripts=/usr/local/opnsense/scripts/OPNsense/Warpgate
certs=/usr/local/etc/warpgate/certs
pwfile=/usr/local/etc/warpgate/private/initial-admin-password
warpgate_bin=/usr/local/bin/warpgate
pidfile=/var/run/${name}.pid              # daemon(8), the supervisor
child_pidfile=/var/run/${name}.child.pid  # warpgate itself
command=/usr/sbin/daemon
# file modes are managed by setup_dirs.sh, so warpgate must not tighten them itself
warpgate_cli="${warpgate_bin} ${warpgate_debug} --skip-securing-files --config ${warpgate_config}"
command_args="-f -S -T ${name} -P ${pidfile} -p ${child_pidfile} -R 5 ${warpgate_cli} run ${warpgate_run_flags}"
extra_commands="prepare"
prepare_cmd=warpgate_prepare
start_precmd=warpgate_prestart
status_cmd=warpgate_status

# run a command line (no shell syntax) as the service user; su -m would otherwise use root's csh
warpgate_as_user()
{
	env SHELL=/bin/sh su -m "${warpgate_user}" -c "$*"
}

# Warpgate's bootstrap does not create a certificate: keep one for listeners without a trust store one.
# Upgrades reuse the certificate the old setup generated, read as the service user.
warpgate_self_signed()
{
	local tmp old="${warpgate_data}/tls"
	[ -s "${certs}/self-signed.pem" ] && [ -s "${certs}/self-signed.key" ] && return 0
	tmp=$(mktemp -d "${certs}/.self-signed.XXXXXX") || return 1
	if ! { warpgate_as_user "cat ${old}.certificate.pem" > "${tmp}/pem" 2>/dev/null &&
	    warpgate_as_user "cat ${old}.key.pem" > "${tmp}/key" 2>/dev/null &&
	    [ -s "${tmp}/pem" ] && [ -s "${tmp}/key" ]; }; then
		openssl req -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 3650 \
		    -subj "/CN=warpgate.local" -addext "subjectAltName=DNS:warpgate.local,DNS:localhost" \
		    -keyout "${tmp}/key" -out "${tmp}/pem" >/dev/null 2>&1 || { rm -rf "${tmp}"; return 1; }
	fi
	chgrp warpgate "${tmp}/pem" "${tmp}/key" && chmod 0640 "${tmp}/pem" "${tmp}/key" &&
	    mv "${tmp}/key" "${certs}/self-signed.key" && mv "${tmp}/pem" "${certs}/self-signed.pem"
	rm -rf "${tmp}"
}

# everything the config refers to; also run by the GUI before `warpgate check` on Apply
warpgate_prepare()
{
	if [ ! -x "${warpgate_bin}" ]; then
		warn "${warpgate_bin} missing, reinstall os-warpgate"
		return 1
	fi
	"${scripts}/setup_dirs.sh" || { warn "cannot create the warpgate user or directories"; return 1; }
	warpgate_self_signed || { warn "cannot create the self-signed certificate"; return 1; }
	"${scripts}/export_certs.php" || { warn "certificate export from System: Trust failed"; return 1; }
}

warpgate_bootstrap()
{
	local password output
	password=$(openssl rand -base64 18) || return 1
	if ! output=$(env WARPGATE_ADMIN_PASSWORD="${password}" SHELL=/bin/sh su -m "${warpgate_user}" -c \
	    "${warpgate_cli} unattended-setup --if-config-exists bootstrap --data-path ${warpgate_data} --http-port 8888" 2>&1); then
		printf '%s\n' "${output}" | logger -t warpgate
		warn "database bootstrap failed (see Services: Warpgate: Log File); it is retried on the next start"
		return 1
	fi
	# the admin user only exists with this password if this run initialised the database
	case "${output}" in
	*"initialising the database"*)
		(umask 077 && printf '%s\n' "${password}" > "${pwfile}.tmp" && mv "${pwfile}.tmp" "${pwfile}")
		;;
	esac
}

warpgate_prestart()
{
	local output
	warpgate_prepare || return 1
	if ! output=$(warpgate_as_user "${warpgate_cli} check" 2>&1); then
		printf '%s\n' "${output}" | logger -t warpgate
		warn "configuration rejected by warpgate check (see Services: Warpgate: Log File)"
		return 1
	fi
	# not fatal: an external database may still be booting; daemon(8) keeps retrying `run` until it answers
	warpgate_bootstrap || warn "starting anyway"
	# daemon runs as warpgate_user (rc.subr), so it cannot create its pidfiles in /var/run
	install -o "${warpgate_user}" -m 0644 /dev/null "${pidfile}"
	install -o "${warpgate_user}" -m 0644 /dev/null "${child_pidfile}"
}

# report warpgate itself: daemon(8) stays alive and keeps restarting it when it cannot start
warpgate_status()
{
	local child
	if [ -z "${rc_pid}" ]; then
		echo "${name} is not running."
		return 1
	fi
	child=$(check_pidfile "${child_pidfile}" "${warpgate_bin}")
	if [ -z "${child}" ]; then
		echo "${name} is not running (daemon ${rc_pid} keeps restarting it, see the log)."
		return 1
	fi
	echo "${name} is running as pid ${child}."
}

run_rc_command "$1"
