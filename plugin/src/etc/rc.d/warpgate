#!/bin/sh

# PROVIDE: warpgate
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# warpgate_enable (bool):  YES to run warpgate (set by the OPNsense template in /etc/rc.conf.d/warpgate)
# warpgate_config (path):  config file, generated by the plugin template
# warpgate_data (path):    data dir: sqlite db, keys, certificate
# warpgate_user (str):     run as this user (rc.subr starts daemon(8) as it)
# warpgate_debug (str):    -d or -dd for debug/trace logging
# warpgate_run_flags (str): flags for `warpgate run` (--enable-admin-token, token in warpgate_env)

# rc.subr idioms: variables are read by rc.subr, local is supported by FreeBSD sh
# shellcheck disable=SC1091,SC2034,SC2223,SC3043
. /etc/rc.subr

name=warpgate
rcvar=warpgate_enable
load_rc_config $name

: ${warpgate_enable:=NO}
: ${warpgate_config:=/usr/local/etc/warpgate.yaml}
: ${warpgate_data:=/var/db/warpgate}
: ${warpgate_user:=warpgate}
: ${warpgate_debug:=}
: ${warpgate_run_flags:=}

warpgate_bin=/usr/local/bin/warpgate
pidfile=/var/run/${name}.pid
command=/usr/sbin/daemon
# file modes are managed here, so warpgate must not tighten them itself
warpgate_cli="${warpgate_bin} ${warpgate_debug} --skip-securing-files --config ${warpgate_config}"
command_args="-f -S -T ${name} -P ${pidfile} -r ${warpgate_cli} run ${warpgate_run_flags}"
start_precmd=warpgate_prestart

warpgate_prestart()
{
	if [ ! -x "${warpgate_bin}" ]; then
		err 1 "${warpgate_bin} missing, reinstall os-warpgate"
	fi
	if ! pw usershow "${warpgate_user}" >/dev/null 2>&1; then
		pw useradd "${warpgate_user}" -c "Warpgate bastion" -d "${warpgate_data}" -s /usr/sbin/nologin || return 1
	fi
	install -d -o "${warpgate_user}" -g "${warpgate_user}" -m 0700 "${warpgate_data}"
	# daemon runs as warpgate_user (rc.subr), so it cannot create its pidfile in /var/run
	install -o "${warpgate_user}" -m 0644 /dev/null "${pidfile}"
	# the config is regenerated by configd as root; warpgate only needs to read it
	chown root:"${warpgate_user}" "${warpgate_config}" && chmod 0640 "${warpgate_config}"
	# may hold the admin API token
	chmod 0600 /etc/rc.conf.d/warpgate

	# first start: create db, keys, certificate and the admin user (db/ alone misses external databases)
	if [ ! -e "${warpgate_data}/.setup-done" ] && [ ! -e "${warpgate_data}/db" ]; then
		warpgate_setup || return 1
	fi
	touch "${warpgate_data}/.setup-done"
	# certificates selected in the OPNsense trust store
	/usr/local/opnsense/scripts/OPNsense/Warpgate/export_certs.php
}

warpgate_setup()
{
	local pwfile="${warpgate_data}/initial-admin-password"
	(umask 077; openssl rand -base64 18 > "${pwfile}") || return 1
	chown "${warpgate_user}" "${pwfile}"
	# setup writes its own config; ours comes from the template, so that one is thrown away.
	# password via env (not argv); su -m runs root's shell (csh), so the command has no shell syntax
	env WARPGATE_ADMIN_PASSWORD="$(cat "${pwfile}")" su -m "${warpgate_user}" -c "${warpgate_bin} --skip-securing-files \
		--config ${warpgate_data}/setup.yaml unattended-setup --data-path ${warpgate_data} --http-port 8888" \
		|| { err 1 "warpgate unattended-setup failed"; }
	rm -f "${warpgate_data}/setup.yaml"
}

run_rc_command "$1"
