<model>
    <mount>//OPNsense/Warpgate</mount>
    <description>Warpgate bastion</description>
    <version>0.3.1</version>
    <items>
        <!-- general -->
        <enabled type="BooleanField"><Default>0</Default><Required>Y</Required></enabled>
        <listen_address type="NetworkField"><Default>0.0.0.0</Default><Required>Y</Required><NetMaskAllowed>N</NetMaskAllowed></listen_address>
        <external_host type="HostnameField"/>
        <tls_certificate type="CertificateField"><BlankDesc>Self-signed (generated by Warpgate)</BlankDesc></tls_certificate>
        <database_url type="TextField"><Mask>/^(sqlite:|postgres(ql)?:\/\/|mysql:\/\/)\S+$/</Mask><ValidationMessage>sqlite:..., postgres://... or mysql://...</ValidationMessage></database_url>
        <log_format type="OptionField"><Default>text</Default><Required>Y</Required><OptionValues><text>text</text><json>json</json></OptionValues></log_format>
        <log_retention type="TextField"><Default>7days</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></log_retention>
        <log_audit_retention type="TextField"><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></log_audit_retention>
        <log_send_to type="TextField"><Mask>/^\/\S+$/</Mask><ValidationMessage>Path of a UNIX datagram socket.</ValidationMessage></log_send_to>
        <debug type="OptionField"><Default>off</Default><Required>Y</Required><OptionValues><off>off</off><debug>debug (-d)</debug><trace>trace (-dd)</trace></OptionValues></debug>
        <admin_token type="TextField"><Mask>/^[A-Za-z0-9._~+\/=-]{16,}$/</Mask><ValidationMessage>At least 16 characters: letters, digits and ._~+/=-</ValidationMessage></admin_token>
        <!-- https -->
        <http_port type="PortField"><Default>8888</Default><Required>Y</Required></http_port>
        <http_external_host type="HostnameField"/>
        <http_external_port type="PortField"/>
        <http_trust_x_forwarded type="BooleanField"><Default>0</Default><Required>Y</Required></http_trust_x_forwarded>
        <http_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></http_proxy_protocol>
        <http_session_max_age type="TextField"><Default>30m</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></http_session_max_age>
        <http_cookie_max_age type="TextField"><Default>1day</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></http_cookie_max_age>
        <http_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></http_certificate>
        <http_sni_certificates type="CertificateField"><BlankDesc>Default</BlankDesc><Multiple>Y</Multiple></http_sni_certificates>
        <!-- ssh -->
        <ssh_enabled type="BooleanField"><Default>1</Default><Required>Y</Required></ssh_enabled>
        <ssh_port type="PortField"><Default>2222</Default><Required>Y</Required></ssh_port>
        <ssh_external_host type="HostnameField"/>
        <ssh_external_port type="PortField"/>
        <ssh_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></ssh_proxy_protocol>
        <ssh_host_key_verification type="OptionField"><Default>prompt</Default><Required>Y</Required><OptionValues><prompt>prompt</prompt><auto_accept>automatically accept</auto_accept><auto_reject>automatically reject</auto_reject><ignore>ignore</ignore></OptionValues></ssh_host_key_verification>
        <ssh_inactivity_timeout type="TextField"><Default>5m</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></ssh_inactivity_timeout>
        <ssh_keepalive_interval type="TextField"><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></ssh_keepalive_interval>
        <ssh_target_handshake_timeout type="TextField"><Default>30s</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></ssh_target_handshake_timeout>
        <!-- mysql -->
        <mysql_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></mysql_enabled>
        <mysql_port type="PortField"><Default>33306</Default><Required>Y</Required></mysql_port>
        <mysql_external_host type="HostnameField"/>
        <mysql_external_port type="PortField"/>
        <mysql_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></mysql_proxy_protocol>
        <mysql_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></mysql_certificate>
        <mysql_advertised_version type="TextField"><Default>8.0.3-Warpgate</Default><Required>Y</Required><Mask>/^\S+$/</Mask></mysql_advertised_version>
        <!-- postgres -->
        <postgres_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></postgres_enabled>
        <postgres_port type="PortField"><Default>55432</Default><Required>Y</Required></postgres_port>
        <postgres_external_host type="HostnameField"/>
        <postgres_external_port type="PortField"/>
        <postgres_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></postgres_proxy_protocol>
        <postgres_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></postgres_certificate>
        <!-- kubernetes -->
        <kubernetes_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></kubernetes_enabled>
        <kubernetes_port type="PortField"><Default>8443</Default><Required>Y</Required></kubernetes_port>
        <kubernetes_external_host type="HostnameField"/>
        <kubernetes_external_port type="PortField"/>
        <kubernetes_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></kubernetes_proxy_protocol>
        <kubernetes_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></kubernetes_certificate>
        <kubernetes_session_max_age type="TextField"><Default>30m</Default><Required>Y</Required><Mask>/^[0-9]+[a-z]*( *[0-9]+[a-z]*)*$/</Mask><ValidationMessage>Duration like 30m, 1day or 7days.</ValidationMessage></kubernetes_session_max_age>
        <!-- vnc -->
        <vnc_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></vnc_enabled>
        <vnc_port type="PortField"><Default>5900</Default><Required>Y</Required></vnc_port>
        <vnc_external_host type="HostnameField"/>
        <vnc_external_port type="PortField"/>
        <vnc_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></vnc_proxy_protocol>
        <vnc_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></vnc_certificate>
        <vnc_enable_ard_auth type="BooleanField"><Default>0</Default><Required>Y</Required></vnc_enable_ard_auth>
        <!-- rdp -->
        <rdp_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></rdp_enabled>
        <rdp_port type="PortField"><Default>3389</Default><Required>Y</Required></rdp_port>
        <rdp_external_host type="HostnameField"/>
        <rdp_external_port type="PortField"/>
        <rdp_proxy_protocol type="BooleanField"><Default>0</Default><Required>Y</Required></rdp_proxy_protocol>
        <rdp_certificate type="CertificateField"><BlankDesc>Default</BlankDesc></rdp_certificate>
        <!-- SSO providers -->
        <sso_providers>
            <provider type="ArrayField">
                <enabled type="BooleanField"><Default>1</Default><Required>Y</Required></enabled>
                <name type="TextField"><Required>Y</Required><Mask>/^[a-z0-9_-]{1,32}$/</Mask><ValidationMessage>Lowercase letters, digits, - and _.</ValidationMessage><Constraints><check001><type>UniqueConstraint</type><ValidationMessage>Provider names must be unique.</ValidationMessage></check001></Constraints></name>
                <label type="TextField"/>
                <type type="OptionField"><Default>custom</Default><Required>Y</Required><OptionValues><custom>Custom OpenID Connect</custom><google>Google</google><azure>Microsoft Entra ID (Azure)</azure><apple>Apple</apple></OptionValues></type>
                <client_id type="TextField"><Required>Y</Required></client_id>
                <client_secret type="TextField"><Required>Y</Required></client_secret>
                <issuer_url type="UrlField"/>
                <scopes type="TextField"><Default>openid,email,profile</Default></scopes>
                <roles_claim type="TextField"/>
                <admin_roles_claim type="TextField"/>
                <role_mappings type="TextField"/>
                <admin_role_mappings type="TextField"/>
                <additional_trusted_audiences type="TextField"/>
                <trust_unknown_audiences type="BooleanField"><Default>0</Default><Required>Y</Required></trust_unknown_audiences>
                <tenant type="TextField"/>
                <key_id type="TextField"/>
                <team_id type="TextField"/>
                <admin_email type="TextField"/>
                <service_account_email type="TextField"/>
                <service_account_key type="TextField"/>
                <auto_create_users type="BooleanField"><Default>0</Default><Required>Y</Required></auto_create_users>
                <disable_local_logout type="BooleanField"><Default>0</Default><Required>Y</Required></disable_local_logout>
                <return_domain_whitelist type="TextField"/>
                <return_url_domain type="OptionField"><Default>external_host</Default><Required>Y</Required><OptionValues><external_host>external host</external_host><host_header>request Host header</host_header></OptionValues></return_url_domain>
                <return_url_prefix type="OptionField"><Default>at</Default><Required>Y</Required><OptionValues><at>@</at><_>_</_></OptionValues></return_url_prefix>
                <credential_policy_http type="TextField"/>
                <credential_policy_ssh type="TextField"/>
                <credential_policy_mysql type="TextField"/>
                <credential_policy_postgres type="TextField"/>
                <kubernetes_client_id type="TextField"/>
                <kubernetes_client_secret type="TextField"/>
                <kubernetes_scopes type="TextField"/>
            </provider>
        </sso_providers>
    </items>
</model>
